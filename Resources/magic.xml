<?xml version="1.0" encoding="UTF-8"?>

<!-- WaveTree II default layout: violet-on-cold-near-black laboratory fascia.
     The interactive coefficient tree is the hero (left, largest area); the
     instrument fascia (engine / morph / envelope / tone / LFOs / mod) wraps it.
     Stealth-beta: no title text anywhere - identity = sigil + accent + BETA.

     Sizing rules (foleys gives every item margin=5 padding=5 and a dark grey
     background unless told otherwise, so the Types below reset all three):
       - every knob row ends in an 18px "chip line": SyncKnob draws its ms/beat
         chip there, a toggle chip can sit there, and class="knobgap" leaves it
         empty so neighbouring knobs stay the same size. -->
<magic>
  <Styles>
    <Style name="default">
      <Nodes/>
      <Classes>
        <fascia background-color="FF171526" border-color="FF2C2942" border="1" radius="8"
                margin="3" padding="6" flex-direction="row"
                caption-size="13" caption-color="FFA6A0BA" caption-placement="top-left"/>
        <hero background-color="FF0A0910" border="0" radius="8" margin="3" padding="2"/>
        <row flex-direction="row"/>
        <stack flex-direction="column"/>
        <knobgap padding="0 0 18 0"/>
        <chip width="56" max-width="56" height="18" max-height="18" margin="1 2"
              flex-align-self="center"/>
        <rowlabel width="16" max-width="16" font-size="12" justification="centred"
                  label-text="FFA275F5"/>
      </Classes>
      <Types>
        <View border="0" margin="0" padding="0" background-color="00000000"/>
        <Slider border="0" margin="0" padding="0" background-color="00000000"
                slider-type="rotary-horizontal-vertical" slider-textbox="textbox-below"
                lookAndFeel="LnfV2"
                caption-size="12" caption-color="FFA6A0BA" caption-placement="centred-top"/>
        <SyncKnob border="0" margin="0" padding="0" background-color="00000000"
                  lookAndFeel="LnfV2"
                  caption-size="12" caption-color="FFA6A0BA" caption-placement="centred-top"/>
        <ToggleButton border="0" margin="2" padding="0" background-color="00000000"
                      caption-size="0" lookAndFeel="LnfV2"/>
        <TextButton border="0" margin="2" padding="0" background-color="00000000"
                    caption-size="0" lookAndFeel="LnfV2"/>
        <ComboBox border="0" margin="2" padding="0" background-color="00000000"
                  caption-size="11" caption-color="FFA6A0BA" caption-placement="centred-top"
                  lookAndFeel="LnfV2" max-height="42"/>
        <Label border="0" margin="0" padding="0" background-color="00000000" lookAndFeel="LnfV2"/>
        <Meter border="0" margin="2" padding="0" background-color="00000000"
               bar-background-color="FF0A0910" bar-fill-color="FFA275F5"
               outline-color="FF2C2942" tickmark-color="FFA6A0BA"/>
        <Sigil border="0" margin="0" padding="0" background-color="00000000"/>
        <PresetBar border="0" margin="0" padding="0" background-color="00000000" lookAndFeel="LnfV2"/>
        <SeedPanel border="0" margin="0" padding="0" background-color="00000000" lookAndFeel="LnfV2"/>
        <KeyboardComponent border="0" margin="2" padding="0" background-color="00000000"/>
      </Types>
      <Palettes>
        <default/>
      </Palettes>
    </Style>
  </Styles>

  <View id="root" resizable="1" resize-corner="1" width="1150" height="740"
        min-width="1000" min-height="660" flex-direction="column"
        background-color="FF0E0D17" padding="4" margin="0" border="0">

    <!-- ── header: sigil | presets | seed dice+lock | output meter ─────── -->
    <View max-height="58" flex-direction="row" margin="2">
      <Sigil width="170" max-width="170" tooltip="Wavelet synthesis: a coefficient tree, inverted."/>
      <PresetBar flex-grow="1" tooltip="Preset picker + save."/>
      <SeedPanel width="240" max-width="240"
                 tooltip="Stochastic seed: last-played value, dice roll, lock."/>
      <Meter source="output" width="76" max-width="76" tooltip="Output level"/>
    </View>

    <!-- ── main: hero tree + fascia columns ────────────────────────────── -->
    <View flex-grow="1" flex-direction="row">

      <!-- hero column -->
      <View flex-grow="1.7" flex-direction="column">
        <TreeView flex-grow="2.4" class="hero"
                  tooltip="Coefficient tree editor. Gutter drag: band gain. Paint rows: node gains (top = boost, bottom = mute). Right-drag erases; double-click gutter resets a band; double-click grid resets all."/>
        <View flex-grow="1" flex-direction="row">
          <WaveScope flex-grow="1.6" class="hero"
                     tooltip="Current wavelet wavetable (one cycle) + live output scope."/>
          <DhSpectrum flex-grow="1" class="hero"
                      tooltip="Multifractal D(h) spectrum of the playing tree."/>
        </View>
      </View>

      <!-- fascia column A: engine / mode / morph + osc / envelope / tone -->
      <View width="288" max-width="288" flex-direction="column">
        <View class="fascia" caption="ENGINE" min-height="76" max-height="76">
          <ComboBox parameter="mode" caption="Mode" tooltip="Tree fill: Bands drawbar / multifractal Cascade / sparse Atoms."/>
          <ComboBox parameter="wavelet" caption="Wavelet" tooltip="Wavelet family used for the inverse transform."/>
          <ComboBox parameter="seedMode" caption="Seed Policy" tooltip="Fixed: one global seed. Per-Key: each key its own reproducible character. Random: fresh roll each strike (lock a good one)."/>
        </View>

        <!-- exactly one of these three is visible, following the Mode menu -->
        <View class="fascia" caption="BANDS" visibility="viewBands">
          <Slider parameter="tilt" caption="Tilt" tooltip="Spectral slope across octave bands."/>
          <Slider parameter="formant" caption="Formant" tooltip="Centre of the band emphasis (a wavelet formant)."/>
          <Slider parameter="bandQ" caption="Band Q" tooltip="Width of the band emphasis."/>
        </View>
        <View class="fascia" caption="CASCADE" visibility="viewCascade">
          <Slider parameter="tilt" caption="Tilt" tooltip="Extra spectral slope on top of the Hurst slope (50 % = none). Painted levels follow it too."/>
          <Slider parameter="hurst" caption="Hurst" tooltip="Hurst exponent: spectral slope of the multifractal cascade (high = smooth)."/>
          <Slider parameter="intermittency" caption="Intermittency" tooltip="Cascade intermittency: multifractal burstiness (widens the D(h) arch)."/>
        </View>
        <View class="fascia" caption="ATOMS" visibility="viewAtoms">
          <Slider parameter="tilt" caption="Tilt" tooltip="Extra spectral slope across the atoms' scales (50 % = none). Painted levels follow it too."/>
          <Slider parameter="density" caption="Density" tooltip="Fraction of nonzero coefficients (sparse wavelet grains)."/>
        </View>

        <View class="row">
          <View class="fascia" caption="MORPH" flex-grow="1.25">
            <ToggleButton parameter="morphOn" text="on" class="chip" width="44" max-width="44"
                          tooltip="Periodically evolve the seed and crossfade tables."/>
            <SyncKnob base="morph" caption="Interval"
                      tooltip="Morph interval: free time, or a beat division that follows the host tempo."/>
          </View>
          <View class="fascia" caption="OSC" flex-direction="column" flex-grow="1.3">
            <Slider parameter="voices" caption="Voices" tooltip="Polyphony: how many notes can sound at once (1 to 16)."/>
            <View class="row" min-height="20" max-height="20" flex-justify-content="center">
              <ToggleButton parameter="antiAlias" text="anti-alias" class="chip"
                            width="68" max-width="68"
                            tooltip="Mip-mapped anti-aliased oscillator read (cleaner high notes)."/>
              <ToggleButton parameter="legato" text="legato" class="chip" width="52" max-width="52"
                            tooltip="A key that takes over a sounding voice keeps its envelope and table (no retrigger). Held keys always come back when the key that cut them is released."/>
            </View>
          </View>
          <View class="fascia" caption="GLIDE" flex-grow="0.75">
            <SyncKnob base="glide" caption="Time"
                      tooltip="Pitch slide from the previous key: free time or a beat division, 0 = off. The same time for any interval."/>
          </View>
        </View>

        <View class="fascia" caption="ENVELOPE">
          <SyncKnob base="attack" caption="Attack" tooltip="Amp attack: free time or beat division."/>
          <SyncKnob base="decay" caption="Decay" tooltip="Amp decay: free time or beat division."/>
          <Slider parameter="sustain" class="knobgap" caption="Sustain" tooltip="Sustain level."/>
          <SyncKnob base="release" caption="Release" tooltip="Amp release: free time or beat division."/>
        </View>

        <!-- no chip line in this row, so it is 18px shorter than the rows above -->
        <View class="fascia" caption="TONE" flex-grow="0.86">
          <Slider parameter="cutoffHz" caption="Cutoff" tooltip="Output low-pass cutoff (Hz)."/>
          <Slider parameter="reso" caption="Reso" tooltip="Filter resonance."/>
          <Slider parameter="output" caption="Output" tooltip="Output level (dB)."/>
        </View>
      </View>

      <!-- fascia column B: LFO A / LFO B / mod depths -->
      <View width="288" max-width="288" flex-direction="column">
        <View class="fascia" caption="LFO A">
          <View class="stack" flex-grow="1.2">
            <ComboBox parameter="lfoAShape" caption="Shape" tooltip="LFO A waveform."/>
            <ComboBox parameter="lfoARetrig" caption="Retrigger" tooltip="Free-running / retrigger on key / transport-locked phase."/>
          </View>
          <SyncKnob base="lfoARate" caption="Rate"
                    tooltip="LFO A period: free time, or a beat division that follows the host tempo."/>
          <View class="stack">
            <Slider parameter="lfoAPhase" caption="Phase" tooltip="LFO A phase offset."/>
            <ToggleButton parameter="lfoABipolar" text="bipolar" class="chip"
                          tooltip="Bipolar (+/-) or unipolar (0..1) output."/>
          </View>
        </View>

        <View class="fascia" caption="LFO B">
          <View class="stack" flex-grow="1.2">
            <ComboBox parameter="lfoBShape" caption="Shape" tooltip="LFO B waveform."/>
            <ComboBox parameter="lfoBRetrig" caption="Retrigger" tooltip="Free-running / retrigger on key / transport-locked phase."/>
          </View>
          <SyncKnob base="lfoBRate" caption="Rate"
                    tooltip="LFO B period: free time, or a beat division that follows the host tempo."/>
          <View class="stack">
            <Slider parameter="lfoBPhase" caption="Phase" tooltip="LFO B phase offset."/>
            <ToggleButton parameter="lfoBBipolar" text="bipolar" class="chip"
                          tooltip="Bipolar (+/-) or unipolar (0..1) output."/>
          </View>
        </View>

        <!-- rows = LFO source, columns = destination -->
        <View class="fascia" caption="MOD DEPTH" flex-direction="column" flex-grow="1.25">
          <View class="row">
            <Label text="A" class="rowlabel"/>
            <Slider parameter="hurstModA" caption="Hurst" tooltip="LFO A depth on Hurst (±%)."/>
            <Slider parameter="intermittencyModA" caption="Intermit" tooltip="LFO A depth on Intermittency (±%)."/>
            <Slider parameter="tiltModA" caption="Tilt" tooltip="LFO A depth on Tilt (±%)."/>
            <Slider parameter="densityModA" caption="Density" tooltip="LFO A depth on Density (±%)."/>
            <Slider parameter="outputModA" caption="Output" tooltip="LFO A depth on Output (±%)."/>
          </View>
          <View class="row">
            <Label text="B" class="rowlabel"/>
            <Slider parameter="hurstModB" caption="Hurst" tooltip="LFO B depth on Hurst (±%)."/>
            <Slider parameter="intermittencyModB" caption="Intermit" tooltip="LFO B depth on Intermittency (±%)."/>
            <Slider parameter="tiltModB" caption="Tilt" tooltip="LFO B depth on Tilt (±%)."/>
            <Slider parameter="densityModB" caption="Density" tooltip="LFO B depth on Density (±%)."/>
            <Slider parameter="outputModB" caption="Output" tooltip="LFO B depth on Output (±%)."/>
          </View>
        </View>
      </View>
    </View>

    <!-- ── on-screen keyboard ──────────────────────────────────────────── -->
    <KeyboardComponent max-height="58" key-down-color="FFA275F5" mouse-over-color="66A275F5"
                       tooltip="On-screen MIDI keyboard."/>
  </View>
</magic>
